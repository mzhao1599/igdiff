{
  "name": "follower-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only follower tracker for Instagram: who doesn't follow back, mutuals, and who unfollowed you.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-types": "wxt prepare"
  },
  "dependencies": {
    "idb": "8.0.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
